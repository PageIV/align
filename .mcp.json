{
  "mcpServers": {
    "align": {
      "command": "/opt/homebrew/bin/node",
      "args": [
        "./mcp/server.mjs"
      ],
      "cwd": ".",
      "env_vars": [
        "HOME",
        "PATH"
      ],
      "startup_timeout_sec": 20,
      "tool_timeout_sec": 60,
      "default_tools_approval_mode": "prompt"
    }
  }
}
